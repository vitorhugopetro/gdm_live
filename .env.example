# ============================================================
# GDM Live Radio — Variáveis de Ambiente
# Copie este arquivo para .env e preencha com valores reais.
# NUNCA commite o arquivo .env no repositório.
# ============================================================

# ─── FIREBASE ────────────────────────────────────────────────
FIREBASE_PROJECT_ID=gdm-live-radio
FIREBASE_STORAGE_BUCKET=gdm-live-radio.appspot.com

# Caminho para a chave de conta de serviço (NÃO commitar o arquivo)
# GOOGLE_APPLICATION_CREDENTIALS=/caminho/para/service-account.json
# Ou use a variável FIREBASE_SERVICE_ACCOUNT_JSON com o conteúdo JSON

# ─── SERVIDOR DE STREAMING ───────────────────────────────────
PORT=3001
NODE_ENV=development

# ─── BIBLIOTECA MUSICAL ──────────────────────────────────────
# Windows local:
MUSIC_LIBRARY_PATH=E:\GDM_LIVE_RADIO\Minhas_Musicas
# Linux / Cloud Run (após upload para Cloud Storage):
# MUSIC_LIBRARY_PATH=/app/music
# CLOUD_STORAGE_BUCKET=gdm-live-radio-music
# MUSIC_SOURCE=cloud-storage

# ─── STREAMING ───────────────────────────────────────────────
STREAM_BITRATE=128
STREAM_SAMPLE_RATE=44100
STREAM_CHANNELS=2

# ─── PROGRAMAÇÃO ─────────────────────────────────────────────
SCHEDULER_MODE=random
AVOID_REPEAT_MINUTES=60
CROSSFADE_SECONDS=3

# ─── ADMINISTRAÇÃO ───────────────────────────────────────────
ADMIN_EMAILS=admin@gracadigital.com
JWT_SECRET=troque-por-uma-string-longa-e-aleatoria-aqui

# ─── CORS ────────────────────────────────────────────────────
CORS_ORIGINS=https://gdmlive.web.app,http://localhost:5173

# ─── LOGS ────────────────────────────────────────────────────
LOG_LEVEL=info

# ─── FRONTEND (prefixo VITE_) ────────────────────────────────
VITE_API_BASE_URL=http://localhost:3001
VITE_STREAM_URL=http://localhost:3001/stream
VITE_FIREBASE_API_KEY=your-firebase-api-key
VITE_FIREBASE_AUTH_DOMAIN=gdm-live-radio.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=gdm-live-radio
VITE_FIREBASE_STORAGE_BUCKET=gdm-live-radio.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
VITE_FIREBASE_APP_ID=your-app-id


{
  "name": "gdm-live-radio-server",
  "version": "1.0.0",
  "description": "GDM Live Radio (Graça Digital) - Node.js/TypeScript streaming backend",
  "main": "dist/server.js",
  "scripts": {
    "dev": "node node_modules/nodemon/bin/nodemon.js --watch src --ext ts --exec \"node node_modules/ts-node/dist/bin.js\" src/server.ts",
    "build": "node node_modules/typescript/bin/tsc",
    "start": "node dist/server.js",
    "lint": "node node_modules/typescript/bin/tsc --noEmit"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "firebase-admin": "^12.3.0",
    "fluent-ffmpeg": "^2.1.3",
    "helmet": "^7.1.0",
    "music-metadata": "^7.13.4",
    "node-cron": "^3.0.3",
    "chokidar": "^3.6.0",
    "uuid": "^10.0.0",
    "winston": "^3.14.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/fluent-ffmpeg": "^2.1.25",
    "@types/node": "^20.14.10",
    "@types/node-cron": "^3.0.11",
    "@types/uuid": "^10.0.0",
    "nodemon": "^3.1.4",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.3"
  },
  "engines": {
    "node": ">=20"
  }
}
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Configurações da rádio — somente admin pode escrever, público pode ler
    match /config/{document} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.token.admin == true;
    }
    
    // Histórico de reprodução — somente admin pode escrever, público pode ler
    match /playbackHistory/{document} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    
    // Biblioteca musical — somente admin pode escrever, público pode ler
    match /library/{document} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.token.admin == true;
    }
    
    // Logs — somente admin
    match /logs/{document} {
      allow read: if request.auth != null && request.auth.token.admin == true;
      allow write: if request.auth != null;
    }
    
    // Usuários admin — somente admin pode ler/escrever
    match /admins/{document} {
      allow read, write: if request.auth != null && request.auth.token.admin == true;
    }

    // Radar de Presença em Tempo Real (Active Listeners)
    // Visitantes anônimos podem registrar seu pulso/heartbeat e atualizar sua presença
    // Qualquer pessoa ou admin autenticado pode ler a audiência
    match /active_listeners/{listenerId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if request.auth != null;
    }
  }
}
